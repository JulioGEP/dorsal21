rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function active() { return signedIn() && userDoc().data.active == true; }
    function admin() { return active() && userDoc().data.role in ['superadmin','admin']; }
    function challengeManager() { return active() && userDoc().data.role in ['superadmin','admin','coach']; }
    function ownsPlayer(playerId) {
      return active() && (
        userDoc().data.playerId == playerId ||
        (userDoc().data.playerIds is list && playerId in userDoc().data.playerIds)
      );
    }
    function authEmail() { return request.auth.token.email; }

    match /invitations/{inviteId} {
      allow create, update, delete: if admin();
      allow read: if admin() || (signedIn() && resource.data.email == authEmail());
    }

    match /staffInvitations/{email} {
      allow create, update, delete: if admin();
      allow read: if admin() || (signedIn() && email == authEmail());
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.active == true
        && request.resource.data.email == authEmail()
        && request.resource.data.role in ['family','admin','director','coordinator','coach','delegate','physio','fitness','psychologist','scout'];
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow update: if admin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerId','playerIds','teamId','teamIds','updatedAt','relationships']));
      allow delete: if admin();
    }

    match /teams/{teamId} {
      allow read: if active();
      allow write: if admin();
    }

    match /players/{playerId} {
      allow read: if admin() || ownsPlayer(playerId) || (active() && resource.data.guardianUid == null);
      allow create, delete: if admin();
      allow update: if admin() || (active() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guardianUid','guardianEmail','guardianUids','guardianEmails','updatedAt']) ||
        (ownsPlayer(playerId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoData','photoUpdatedAt','updatedAt']))
      ));
    }

    match /challenges/{id} { allow read: if active(); allow write: if challengeManager(); }
    match /challengeTasks/{id} { allow read: if active(); allow write: if challengeManager(); }
    match /challengeSubmissions/{id} {
      allow create: if active()
        && request.resource.data.userId == request.auth.uid
        && ownsPlayer(request.resource.data.playerId);
      allow read: if challengeManager() || (active() && resource.data.userId == request.auth.uid);
      allow update, delete: if admin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
